{
  "name": "learna",
  "version": "1.0.0",
  "description": "Learna - School Management System (Backend: .NET 8, Frontend: Angular 17+)",
  "scripts": {
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd src/backend/Learna.Api && dotnet watch run",
    "start:frontend": "cd src/frontend/learna-app && ng serve --open",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd src/backend/Learna.Api && dotnet build",
    "build:frontend": "cd src/frontend/learna-app && ng build",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "dotnet test",
    "test:frontend": "cd src/frontend/learna-app && ng test --watch=false"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "author": "",
  "license": "ISC"
}
