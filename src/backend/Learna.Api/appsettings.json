{
  "Attendance": {
    "EditWindowDays": 7
  },
  "Storage": {
    "RootPath": "storage",
    "MaxFileSizeMb": 25,
    "AllowedExtensions": [ ".pdf", ".doc", ".docx", ".ppt", ".pptx", ".xls", ".xlsx", ".jpg", ".jpeg", ".png", ".gif", ".webp", ".mp4", ".zip", ".txt" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=learna;User=root;Password=root;"
  },
  "Jwt": {
    "SecretKey": "YourSuperSecretKeyThatIsAtLeast32CharactersLongForProduction!",
    "Issuer": "LearnaApi",
    "Audience": "LearnaApp",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
